<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Professional Development Course Logger</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .header {
            text-align: center;
            color: white;
            margin-bottom: 40px;
            animation: fadeInDown 0.8s ease;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .card {
            background: white;
            border-radius: 16px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            margin-bottom: 30px;
            animation: fadeInUp 0.8s ease;
        }

        .form-group {
            margin-bottom: 25px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 500;
            font-size: 0.95em;
        }

        input[type="text"],
        input[type="date"],
        input[type="number"],
        select,
        textarea {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 1em;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        input:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        .row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .file-upload {
            border: 2px dashed #667eea;
            border-radius: 8px;
            padding: 30px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: #f8f9ff;
        }

        .file-upload:hover {
            background: #eef1ff;
            border-color: #764ba2;
        }

        .file-upload input[type="file"] {
            display: none;
        }

        .file-upload-icon {
            font-size: 3em;
            margin-bottom: 10px;
            color: #667eea;
        }

        .file-upload-text {
            color: #666;
            margin-bottom: 5px;
        }

        .file-upload-hint {
            color: #999;
            font-size: 0.85em;
        }

        .btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 14px 32px;
            border: none;
            border-radius: 8px;
            font-size: 1.1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 10px;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }

        .btn:active {
            transform: translateY(0);
        }

        .log-entry {
            background: #f8f9ff;
            border-left: 4px solid #667eea;
            padding: 20px;
            margin-bottom: 15px;
            border-radius: 8px;
            animation: slideIn 0.5s ease;
        }

        .log-entry h3 {
            color: #333;
            margin-bottom: 10px;
        }

        .log-meta {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 10px;
            font-size: 0.9em;
            color: #666;
        }

        .log-meta span {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .log-description {
            color: #555;
            line-height: 1.6;
            margin-top: 10px;
        }

        .badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.85em;
            font-weight: 600;
        }

        .badge-completed {
            background: #d4edda;
            color: #155724;
        }

        .badge-in-progress {
            background: #fff3cd;
            color: #856404;
        }

        .badge-category {
            background: #e3f2fd;
            color: #1565c0;
        }

        .badge-academic {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .badge-pastoral {
            background: #fce4ec;
            color: #c2185b;
        }

        .badge-other-half {
            background: #fff9c4;
            color: #f57f17;
        }

        .badge-other {
            background: #f3e5f5;
            color: #7b1fa2;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #999;
        }

        .empty-state-icon {
            font-size: 4em;
            margin-bottom: 20px;
            opacity: 0.3;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @media (max-width: 768px) {
            .row {
                grid-template-columns: 1fr;
            }

            .header h1 {
                font-size: 2em;
            }

            .card {
                padding: 25px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📚 Professional Development Logger</h1>
            <p>Track your learning journey and professional growth</p>
        </div>

        <div class="card">
            <h2 style="margin-bottom: 30px; color: #333;">Add New Course Log</h2>
            <form id="courseForm">
                <div class="row">
                    <div class="form-group">
                        <label for="courseName">Course Name *</label>
                        <input type="text" id="courseName" required placeholder="e.g., Advanced Project Management">
                    </div>
                    <div class="form-group">
                        <label for="provider">Provider/Institution *</label>
                        <input type="text" id="provider" required placeholder="e.g., Coursera, LinkedIn Learning">
                    </div>
                </div>

                <div class="row">
                    <div class="form-group">
                        <label for="startDate">Start Date *</label>
                        <input type="date" id="startDate" required>
                    </div>
                    <div class="form-group">
                        <label for="completionDate">Completion Date</label>
                        <input type="date" id="completionDate">
                    </div>
                </div>

                <div class="row">
                    <div class="form-group">
                        <label for="category">Category *</label>
                        <select id="category" required>
                            <option value="">Select category</option>
                            <option value="academic">Academic</option>
                            <option value="pastoral">Pastoral</option>
                            <option value="other-half">Other Half</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="status">Status *</label>
                        <select id="status" required>
                            <option value="">Select status</option>
                            <option value="completed">Completed</option>
                            <option value="in-progress">In Progress</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label for="description">Course Description & Key Learnings</label>
                    <textarea id="description" placeholder="Describe what you learned and how it applies to your professional development..."></textarea>
                </div>

                <div class="form-group">
                    <label>Upload Certificate or Documentation</label>
                    <div class="file-upload" onclick="document.getElementById('fileInput').click()">
                        <input type="file" id="fileInput" accept=".pdf,.jpg,.jpeg,.png" multiple>
                        <div class="file-upload-icon">📄</div>
                        <div class="file-upload-text">Click to upload files</div>
                        <div class="file-upload-hint">PDF, JPG, or PNG (Max 10MB)</div>
                        <div id="fileNames" style="margin-top: 10px; color: #667eea; font-weight: 500;"></div>
                    </div>
                </div>

                <button type="submit" class="btn">Add Course Log</button>
            </form>
        </div>

        <div class="card">
            <h2 style="margin-bottom: 20px; color: #333;">Your Course Logs</h2>
            
            <div class="row" style="margin-bottom: 25px;">
                <div class="form-group">
                    <label for="filterCategory">Filter by Category</label>
                    <select id="filterCategory">
                        <option value="all">All Categories</option>
                        <option value="academic">Academic</option>
                        <option value="pastoral">Pastoral</option>
                        <option value="other-half">Other Half</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="pdrDate">PDR Date (filters last 2 years)</label>
                    <input type="date" id="pdrDate" placeholder="Select PDR date">
                </div>
            </div>

            <button onclick="clearFilters()" style="background: #6c757d; padding: 10px 20px; margin-bottom: 20px;" class="btn">Clear All Filters</button>

            <div id="logsList">
                <div class="empty-state">
                    <div class="empty-state-icon">📋</div>
                    <p>No course logs yet. Add your first course above!</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        const logs = [];
        let currentFilter = 'all';
        let pdrDate = null;
        let dateFrom = null;
        let dateTo = null;

        document.getElementById('fileInput').addEventListener('change', function(e) {
            const fileNames = Array.from(e.target.files).map(f => f.name).join(', ');
            document.getElementById('fileNames').textContent = fileNames || '';
        });

        document.getElementById('filterCategory').addEventListener('change', function(e) {
            currentFilter = e.target.value;
            renderLogs();
        });

        document.getElementById('pdrDate').addEventListener('change', function(e) {
            pdrDate = e.target.value ? new Date(e.target.value) : null;
            renderLogs();
        });

        document.getElementById('dateFrom').addEventListener('change', function(e) {
            dateFrom = e.target.value ? new Date(e.target.value) : null;
            renderLogs();
        });

        document.getElementById('dateTo').addEventListener('change', function(e) {
            dateTo = e.target.value ? new Date(e.target.value) : null;
            renderLogs();
        });

        function clearFilters() {
            currentFilter = 'all';
            pdrDate = null;
            dateFrom = null;
            dateTo = null;
            document.getElementById('filterCategory').value = 'all';
            document.getElementById('pdrDate').value = '';
            document.getElementById('dateFrom').value = '';
            document.getElementById('dateTo').value = '';
            renderLogs();
        }

        document.getElementById('courseForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const log = {
                id: Date.now(),
                courseName: document.getElementById('courseName').value,
                provider: document.getElementById('provider').value,
                category: document.getElementById('category').value,
                startDate: document.getElementById('startDate').value,
                completionDate: document.getElementById('completionDate').value,
                status: document.getElementById('status').value,
                description: document.getElementById('description').value,
                files: Array.from(document.getElementById('fileInput').files).map(f => f.name)
            };

            logs.unshift(log);
            renderLogs();
            this.reset();
            document.getElementById('fileNames').textContent = '';
        });

        function getCategoryLabel(category) {
            const labels = {
                'academic': 'Academic',
                'pastoral': 'Pastoral',
                'other-half': 'Other Half',
                'other': 'Other'
            };
            return labels[category] || category;
        }

        function filterByDate(log) {
            const logDate = new Date(log.startDate);
            
            // PDR filter (last 2 years from PDR date)
            if (pdrDate) {
                const twoYearsBeforePDR = new Date(pdrDate);
                twoYearsBeforePDR.setFullYear(twoYearsBeforePDR.getFullYear() - 2);
                if (logDate < twoYearsBeforePDR || logDate > pdrDate) {
                    return false;
                }
            }
            
            // Date range filter
            if (dateFrom && logDate < dateFrom) {
                return false;
            }
            if (dateTo && logDate > dateTo) {
                return false;
            }
            
            return true;
        }

        function renderLogs() {
            const logsList = document.getElementById('logsList');
            let filteredLogs = logs;
            
            // Apply category filter
            if (currentFilter !== 'all') {
                filteredLogs = filteredLogs.filter(log => log.category === currentFilter);
            }
            
            // Apply date filters
            filteredLogs = filteredLogs.filter(filterByDate);
            
            if (filteredLogs.length === 0) {
                let message = 'No course logs yet. Add your first course above!';
                if (logs.length > 0) {
                    message = 'No courses match the selected filters.';
                }
                logsList.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-state-icon">📋</div>
                        <p>${message}</p>
                    </div>
                `;
                return;
            }

            logsList.innerHTML = filteredLogs.map(log => `
                <div class="log-entry">
                    <h3>${log.courseName}</h3>
                    <div class="log-meta">
                        <span class="badge badge-${log.category}">${getCategoryLabel(log.category)}</span>
                        <span>🏢 ${log.provider}</span>
                        <span>📅 ${new Date(log.startDate).toLocaleDateString()}</span>
                        ${log.completionDate ? `<span>✅ ${new Date(log.completionDate).toLocaleDateString()}</span>` : ''}
                        <span class="badge badge-${log.status === 'completed' ? 'completed' : 'in-progress'}">
                            ${log.status === 'completed' ? 'Completed' : 'In Progress'}
                        </span>
                    </div>
                    ${log.description ? `<div class="log-description">${log.description}</div>` : ''}
                    ${log.files.length > 0 ? `<div style="margin-top: 10px; color: #667eea; font-size: 0.9em;">📎 ${log.files.join(', ')}</div>` : ''}
                </div>
            `).join('');
        }
    </script>
</body>
</html>
